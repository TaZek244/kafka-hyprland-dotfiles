# ============================================================
# Kafka Theme cho btop — tông tối, rượu vang / hồng đậm
# Lấy cảm hứng từ bảng màu "Kafka's Web" (Honkai: Star Rail)
# Đặt file này vào ~/.config/btop/themes/ và chọn trong btop:
#   color_theme = "kafka"
# ============================================================

# --- Nền & chữ cơ bản ---
theme[main_bg]="#16101e"
theme[main_fg]="#f2e6ee"
theme[title]="#d4af6a"
theme[hi_fg]="#d4af6a"
theme[selected_bg]="#5c1d40"
theme[selected_fg]="#f2e6ee"
theme[inactive_fg]="#6e5a6b"

# --- Khung, vạch ngăn & meter ---
theme[graph_text]="#d4af6a"
theme[meter_bg]="#2a1626"
theme[proc_misc]="#e05a8c"
theme[cpu_box]="#b8326a"
theme[mem_box]="#b8326a"
theme[net_box]="#b8326a"
theme[proc_box]="#b8326a"
theme[div_line]="#3b1a33"

# --- Nhiệt độ: vàng -> cam -> đỏ hồng ---
theme[temp_start]="#d4af6a"
theme[temp_mid]="#e07a3a"
theme[temp_end]="#ff4d6d"

# --- CPU: rượu vang -> burgundy -> hồng ---
theme[cpu_start]="#8e2a5c"
theme[cpu_mid]="#b8326a"
theme[cpu_end]="#e05a8c"

# --- Bộ nhớ: free / cached / available / used ---
theme[free_start]="#6a3d8e"
theme[free_mid]="#9a5cc0"
theme[free_end]="#c48ae0"

theme[cached_start]="#6a3d8e"
theme[cached_mid]="#9a5cc0"
theme[cached_end]="#c48ae0"

theme[available_start]="#d4af6a"
theme[available_mid]="#e0b878"
theme[available_end]="#f0d39a"

theme[used_start]="#8e2a5c"
theme[used_mid]="#b8326a"
theme[used_end]="#e05a8c"

# --- Mạng: download (vàng) / upload (tím) ---
theme[download_start]="#d4af6a"
theme[download_mid]="#e0b878"
theme[download_end]="#f0d39a"

theme[upload_start]="#6a3d8e"
theme[upload_mid]="#9a5cc0"
theme[upload_end]="#c48ae0"

# --- Tiến trình: rượu vang -> burgundy -> hồng ---
theme[process_start]="#8e2a5c"
theme[process_mid]="#b8326a"
theme[process_end]="#e05a8c"
