[global]
    monitor = 0
    follow = mouse
    width = (280, 380)
    height = (0, 160)
    origin = top-right
    # Dunst đã tự né thanh trên, nên chỉ cần lề nhỏ thay vì 58
    offset = 16x10
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#b8326a"
    gap_size = 6
    separator_color = frame
    sort = yes
    font = FiraCode Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>󱇪 %s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    corner_radius = 14
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#140e1ce6"
    foreground = "#d8b4f8"
    frame_color = "#9b4dca"
    timeout = 5

[urgency_normal]
    background = "#140e1cf0"
    foreground = "#f4eef8"
    frame_color = "#b8326a"
    highlight = "#c77dff"
    timeout = 7

[urgency_critical]
    background = "#2b0f1ef5"
    foreground = "#ffffff"
    frame_color = "#d4af6a"
    timeout = 0

# Cảnh báo của alert-watch.py khi đã hiện bảng giữa màn hình (alert-popup.py): chỉ ghi vào lịch sử
# (nút chuông trên dock), không hiện thêm hộp dunst trùng.
[kafka-alert-popup]
    category = "kafka.alert.popup"
    skip_display = true
