{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/hypr/wallpapers/Kafka_thumbail.jpg",
        "width": 26,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "  ➜  ",
        "color": {
            "keys": "35",
            "title": "95"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        },
        {
            "type": "os",
            "key": "󰣇  OS      ",
            "keyColor": "35"
        },
        {
            "type": "kernel",
            "key": "󰌽  Kernel  ",
            "keyColor": "35"
        },
        {
            "type": "wm",
            "key": "󱂬  WM      ",
            "keyColor": "95"
        },
        {
            "type": "terminal",
            "key": "󰆍  Terminal",
            "keyColor": "95"
        },
        {
            "type": "cpu",
            "key": "󰻠  CPU     ",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU     ",
            "keyColor": "33"
        },
        {
            "type": "memory",
            "key": "󰍛  Memory  ",
            "keyColor": "35"
        },
        {
            "type": "uptime",
            "key": "󰥔  Uptime  ",
            "keyColor": "95"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
