/* Waybar: 2 thanh. Định nghĩa thật nằm ở:
 *   topbar-current.jsonc → symlink (tự sinh, gitignore) do hypr/scripts/ui-theme.sh đặt:
 *                          topbar.jsonc (phẳng) hoặc topbar-pixel.jsonc (HUD RPG, include topbar.jsonc)
 *   dockbar.jsonc        → dock dọc bên phải
 * Thiếu symlink thì rơi về topbar.jsonc (include thứ hai; file include trước thắng).
 * Đổi CẤU TRÚC thanh (module/thứ tự) thì phải khởi động lại Waybar, SIGUSR2 không đủ. */
[
    { "include": ["~/.config/waybar/topbar-current.jsonc", "~/.config/waybar/topbar.jsonc"] },
    { "include": ["~/.config/waybar/dockbar.jsonc"] }
]
