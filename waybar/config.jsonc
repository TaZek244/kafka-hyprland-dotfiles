[
{
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 0,             /* khung chữ L gắn sát mép màn hình (trên/trái/phải) */
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 10,

    "modules-left": [
        "group/kafka",
        "hyprland/workspaces",
        "custom/columns",
        "network#speed"
    ],
    "modules-center": [
        "clock",
        "mpris"
    ],
    "modules-right": [
        "group/system",
        "custom/ime",
        "group/control",
        "custom/notifications",
        "custom/corner"
    ],

    // Khối Kafka: chữ "Kafka" mở walker, icon bên phải chuyển chế độ cuộn ↔ Desktop (Super + D)
    "group/kafka": {
        "orientation": "horizontal",
        "modules": ["custom/launcher", "custom/layoutmode"]
    },

    "custom/launcher": {
        "format": "󰣇  Kafka",
        "on-click": "walker",
        "on-click-right": "~/.config/hypr/scripts/desktop-mode.sh toggle",
        "tooltip": true,
        "tooltip-format": "Bấm: mở ứng dụng (Super + Space)\nChuột phải: chuyển cuộn ↔ Desktop (Super + D)"
    },

    // Bản đồ cột của workspace đang xem (layout cuộn): ▮ cột, ▤ cột chồng; vàng = đang dùng, mờ = khuất.
    // Hyprland bắn signal 15 khi đổi focus/mở/đóng/đổi workspace (hyprland.lua). Ẩn khi không có cột xếp.
    "custom/columns": {
        "exec": "~/.config/hypr/scripts/column-map.sh",
        "return-type": "json",
        "interval": 60,
        "signal": 15,
        "escape": false,
        "on-click": "hyprctl dispatch 'hl.dsp.layout(\"colresize +conf\")'; pkill -RTMIN+15 waybar",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ direction = \"left\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ direction = \"right\" })'"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        // Kiểu "Focus Hint": số La Mã + icon app đang có trong workspace (trống thì chỉ số, CSS làm mờ/thu nhỏ)
        "format": "{icon}",          /* icon app chuyển sang bản đồ cột custom/columns (theo yêu cầu) */
        "format-window-separator": "",
        "window-rewrite-default": " 󰣆",
        "window-rewrite": {
            "class<kitty>": " ",
            "class<chromium>": " ",
            "class<code-oss|code|Code>": " 󰨞",
            "class<thunar|Thunar>": " ",
            "class<mousepad|org.xfce.mousepad>": " ",
            "class<mpv>": " ",
            "class<imv.*>": " ",
            "class<kafka-btop>": " ",
            "class<blueman.*>": " 󰂯",
            "class<kafka-cava>": " 󰎈"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X",
            "urgent": "",
            "default": ""
        }
    },

    // Chuyển chế độ cuộn ↔ Desktop (Super + D); cập nhật qua signal 14.
    "custom/layoutmode": {
        "exec": "~/.config/hypr/scripts/desktop-mode.sh status",
        "return-type": "json",
        "interval": 60,
        "signal": 14,
        "on-click": "~/.config/hypr/scripts/desktop-mode.sh toggle"
    },

    // Tốc độ mạng hiện tại (thay ô tiêu đề cửa sổ). Đứng cuối nhóm trái nên đổi độ rộng không xô ô khác.
    "network#speed": {
        "interval": 2,
        "format": "󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
        "format-disconnected": "󰖪  Mất mạng",
        "format-disabled": "󰖪  Tắt mạng",
        "min-length": 24,
        "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ifname}\nIP: {ipaddr}/{cidr}\nBấm: bảng Wi-Fi",
        "tooltip-format-ethernet": "Có dây · {ifname}\nIP: {ipaddr}/{cidr}\nBấm: mở nmtui",
        "tooltip-format-disconnected": "Không có kết nối · Bấm: bảng Wi-Fi",
        "on-click": "~/.config/hypr/scripts/control-popup.py wifi"
    },

    "clock": {
        "format": "󰥔  {:%H:%M   󰃭  %a, %d/%m}",
        // Bấm = popup lịch Kafka (giờ, âm lịch, bảng tháng); bấm lần nữa / Esc / bấm ra ngoài = đóng
        "on-click": "~/.config/hypr/scripts/clock-popup.py",
        "tooltip": false
    },


    "mpris": {
        "format": "{status_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 40,
        "status-icons": {
            "playing": "󰎆",
            "paused": "󰏤",
            "stopped": "󰓛"
        },
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {title} — {artist}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "~/.config/hypr/scripts/control-popup.py audio",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Trái: bảng âm thanh (loa, micro, từng app) · Phải: tắt/mở tiếng · Cuộn: âm lượng"
    },

    /* Bluetooth: trái mở Blueman, phải bật/tắt nhanh (rfkill) */
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Bấm: cài đặt nhanh · Cuộn: độ sáng",
        "on-click": "~/.config/hypr/scripts/control-popup.py main",
        "on-scroll-up": "brightnessctl s 5%+",
        "on-scroll-down": "brightnessctl s 5%-"
    },

    /* Thông số máy gộp chung một viên thuốc: CPU · RAM · nhiệt độ */
    "group/system": {
        "orientation": "inherit",
        "modules": ["cpu", "memory", "temperature"]
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "tooltip-format": "CPU: {usage}% · bấm mở btop",
        "interval": 3,
        "on-click": "~/.config/hypr/scripts/toggle-app.sh kafka-btop kitty --class kafka-btop -e btop"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}/{total:0.1f} GiB · bấm mở btop",
        "interval": 3,
        "on-click": "~/.config/hypr/scripts/toggle-app.sh kafka-btop kitty --class kafka-btop -e btop"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}\nTrái: cài đặt nhanh · Phải: đổi chế độ nguồn (tiết kiệm → cân bằng → hiệu năng)",
        "on-click": "~/.config/hypr/scripts/control-popup.py main",
        "on-click-right": "~/.config/hypr/scripts/power-profile.sh"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "interval": 3,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "󰸁 {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "tooltip-format": "Nhiệt độ CPU: {temperatureC}°C",
        "on-click": "~/.config/hypr/scripts/toggle-app.sh kafka-btop kitty --class kafka-btop -e btop"
    },

    // Cụm "Cài đặt nhanh": wifi · bluetooth · âm lượng · độ sáng · pin trong một viên thuốc.
    // Bấm bất kỳ ô nào = popup Trung tâm điều khiển (hypr/scripts/control-popup.py), mở đúng trang tương ứng.
    "group/control": {
        "orientation": "inherit",
        "modules": ["network#top", "custom/vpn", "bluetooth#top", "pulseaudio", "backlight", "battery"]
    },
    // VPN (hypr/scripts/vpn.sh): kết nối WireGuard/VPN của NetworkManager hoặc Cloudflare WARP.
    // Trái: bật/tắt · Phải: chọn kết nối. Nhập file WireGuard: vpn.sh import <file.conf>
    "custom/vpn": {
        "exec": "~/.config/hypr/scripts/vpn.sh status",
        "return-type": "json",
        "interval": 30,
        "signal": 16,
        "on-click": "~/.config/hypr/scripts/vpn.sh toggle",
        "on-click-right": "~/.config/hypr/scripts/vpn.sh select"
    },
    "network#top": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰤫",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "Wifi: {essid} ({signalStrength}%)\nIP: {ipaddr}\nTrái: bảng Wi-Fi · Phải: bật/tắt wifi",
        "tooltip-format-ethernet": "Dây mạng: {ifname}\nIP: {ipaddr}\nTrái: bảng Wi-Fi",
        "tooltip-format-disconnected": "Chưa kết nối mạng\nTrái: bảng Wi-Fi · Phải: bật/tắt wifi",
        "on-click": "~/.config/hypr/scripts/control-popup.py wifi",
        "on-click-right": "[ \"$(nmcli radio wifi)\" = enabled ] && nmcli radio wifi off || nmcli radio wifi on"
    },
    "bluetooth#top": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "Bluetooth: đang bật, chưa nối thiết bị\nTrái: bảng Bluetooth · Phải: tắt",
        "tooltip-format-disabled": "Bluetooth: đang tắt\nTrái: bảng Bluetooth · Phải: bật",
        "tooltip-format-off": "Bluetooth: đang tắt\nTrái: bảng Bluetooth · Phải: bật",
        "tooltip-format-connected": "Đang nối {num_connections} thiết bị:\n{device_enumerate}\nTrái: bảng Bluetooth · Phải: tắt",
        "tooltip-format-enumerate-connected": "• {device_alias}",
        "tooltip-format-enumerate-connected-battery": "• {device_alias} ({device_battery_percentage}%)",
        "on-click": "~/.config/hypr/scripts/control-popup.py bluetooth",
        "on-click-right": "if rfkill list bluetooth | grep -q 'Soft blocked: yes'; then rfkill unblock bluetooth; else rfkill block bluetooth; fi"
    },
    "custom/ime": {
        "exec": "~/.config/hypr/scripts/ime-status.sh",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "pgrep -x fcitx5 >/dev/null && fcitx5-remote -t || ~/.config/hypr/scripts/ime-guard.sh restart",
        "on-click-middle": "~/.config/hypr/scripts/ime-guard.sh restart",
        "on-click-right": "setsid -f fcitx5-configtool >/dev/null 2>&1"
    },


    // Ô góc: nằm ngay trên cột dock, nối thanh trên với dock thành khung chữ L (dấu nhận biết chỗ nối).
    // Bấm: bật/tắt tổng quan (hyprshell, như nhấn-thả Super) · lăn: đổi workspace · bấm phải: scratchpad (Super + S).
    "custom/corner": {
        "exec": "printf '%s\\n' '{\"text\":\"󰯊\",\"tooltip\":\"Góc Kafka\\nBấm: tổng quan cửa sổ (như nhấn-thả Super)\\nLăn chuột: đổi workspace\\nBấm phải: scratchpad (Super + S)\"}'",
        "return-type": "json",
        "interval": "once",
        "on-click": "~/.config/hypr/scripts/overview-toggle.sh",
        "on-click-right": "hyprctl dispatch \"hl.dsp.workspace.toggle_special('magic')\"",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "custom/notifications": {
        "exec": "n=$(dunstctl count history); if [ \"$(dunstctl is-paused)\" = true ]; then i='󰂛'; c=paused; else i='󰂚'; c=idle; fi; [ \"$n\" -gt 0 ] && { t=\"$i $n\"; c=\"$c has\"; } || t=\"$i\"; printf '{\"text\":\"%s\",\"class\":\"%s\",\"tooltip\":\"%s thông báo trong lịch sử\\\\nTrái: xem lại thông báo cũ · Phải: xóa hết\"}\\n' \"$t\" \"$c\" \"$n\"",
        "return-type": "json",
        "interval": 30,
        "signal": 10,
        "on-click": "dunstctl history-pop; pkill -RTMIN+10 waybar",
        "on-click-right": "dunstctl history-clear; pkill -RTMIN+10 waybar"
    }
},

/* ---------- THANH PHẢI: dock dọc nổi, bo góc, 60px ---------- */
{
    "name": "dockbar",
    "reload_style_on_change": true,   /* dock-density.sh đổi CSS theo số cửa sổ */
    "layer": "top",
    "position": "right",
    "width": 48,
    "margin-top": 0,             /* dính liền dưới thanh trên -> khung chữ L (ô góc custom/corner nằm ngay trên) */
    "margin-bottom": 0,          /* gắn sát mép dưới và mép phải màn hình */
    "margin-right": 0,
    "spacing": 0,

    "modules-left":   ["custom/apps", "custom/tools", "group/pinned", "tray"],
    "modules-center": ["group/windows"],
    "modules-right":  ["group/actions"],

    /* Đầu dock, cố định: wifi · bluetooth · bộ gõ (thay icon trong khay, vì khay đổi thứ tự).
     * nm-applet/fcitx vẫn chạy (hỏi mật khẩu wifi, bộ gõ) nhưng bị ẩn khỏi khay bằng ignore-list. */

    "custom/apps": {
        "format": "󰀻",
        "tooltip-format": "Tất cả ứng dụng",
        "on-click": "walker"
    },

    "group/pinned": {
        "orientation": "inherit",
        "modules": [
            "custom/pin-browser",
            "custom/pin-terminal",
            "custom/pin-files",
            "custom/pin-code",
            "custom/pin-editor"
        ]
    },
    "custom/pin-browser":  { "format": "󰊯", "tooltip-format": "Chromium",       "on-click": "setsid -f chromium >/dev/null 2>&1" },
    "custom/pin-terminal": { "format": "󰆍", "tooltip-format": "Kitty",          "on-click": "setsid -f kitty >/dev/null 2>&1" },
    "custom/pin-files":    { "format": "󰉋", "tooltip-format": "Tệp (Thunar)",   "on-click": "setsid -f thunar >/dev/null 2>&1" },
    "custom/pin-code":     { "format": "󰨞", "tooltip-format": "VS Code",        "on-click": "setsid -f code >/dev/null 2>&1" },
    "custom/pin-editor":   { "format": "󰷈", "tooltip-format": "Text Editor",    "on-click": "setsid -f mousepad >/dev/null 2>&1" },

    /* Nút công cụ (trên cùng dock, vị trí cố định): rê chuột vào thì scripts/tools-popup.py
     * hiện popup ngang bên trái dock (clipboard · chụp/quay · phím tắt · không làm phiền).
     * Icon do tools-status.sh sinh: REC đỏ khi đang quay, chuông gạch khi không làm phiền. */
    "custom/tools": {
        "exec": "~/.config/hypr/scripts/tools-status.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 12,
        "tooltip": false
    },
    /* Thẻ app đang mở: nút ẩn/hiện ở đầu thẻ, bên dưới là các app, GỘP theo app
     * (2 cửa sổ kitty = 1 icon kèm "x2"). wlr/taskbar không gộp được, nên hypr/scripts/dock-apps.py
     * vẽ sẵn mỗi app thành 1 ảnh (icon + huy hiệu xN + nền vàng nếu đang dùng) và 10 ô image#wN hiện chúng;
     * ô trống tự ẩn. Hyprland gọi `dock-apps.py render` khi mở/đóng/đổi cửa sổ rồi báo signal 13.
     * Trái: chuyển tới (bấm tiếp: xoay vòng các cửa sổ cùng app) · Giữa: đóng cửa sổ dùng gần nhất. */
    "group/windows": {
        "orientation": "inherit",
        "modules": ["custom/hidden", "image#w1", "image#w2", "image#w3", "image#w4", "image#w5", "image#w6", "image#w7", "image#w8", "image#w9", "image#w10"]
    },
    "image#w1":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 1", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 1", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 1" },
    "image#w2":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 2", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 2", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 2" },
    "image#w3":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 3", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 3", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 3" },
    "image#w4":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 4", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 4", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 4" },
    "image#w5":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 5", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 5", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 5" },
    "image#w6":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 6", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 6", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 6" },
    "image#w7":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 7", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 7", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 7" },
    "image#w8":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 8", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 8", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 8" },
    "image#w9":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 9", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 9", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 9" },
    "image#w10":  { "exec": "~/.config/hypr/scripts/dock-apps.py slot 10", "size": 40, "signal": 13, "on-click": "~/.config/hypr/scripts/dock-apps.py click 10", "on-click-middle": "~/.config/hypr/scripts/dock-apps.py close 10" },

    /* Ẩn/hiện cửa sổ (hypr/scripts/hide-windows.py): hiện số cửa sổ đang ẩn */
    "custom/hidden": {
        "exec": "~/.config/hypr/scripts/hide-windows.py status",
        "return-type": "json",
        "interval": 60,
        "signal": 11,
        "on-click": "~/.config/hypr/scripts/hide-windows.py menu",
        "on-click-right": "~/.config/hypr/scripts/hide-windows.py show-all"
    },
    /* Đáy dock: nút mở hộp chức năng (popup ngang bên trái dock) + nút nguồn.
       Không dùng drawer: nó bung dọc và đè lên thẻ app đang mở. */
    "group/actions": {
        "orientation": "inherit",
        "modules": ["custom/actions", "custom/powermenu"]
    },
    "custom/actions": {
        "format": "󰍜",
        "tooltip-format": "Chức năng nhanh: sóng nhạc · treo · nổi/xếp · đóng app · chia khu · khóa",
        "on-click": "~/.config/hypr/scripts/actionsmenu.sh"
    },
    "custom/powermenu": {
        "format": "󰐥",
        "tooltip-format": "Menu nguồn (Super + M)",
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    },

    "tray": {
        "icon-size": 28,         /* theme icon nhảy bậc: 28 -> wifi ~14px, 30 -> ~22px, 32 -> ~24px */
        "spacing": 10,
        /* Wifi và bộ gõ đã có nút riêng ở đầu dock (group/status) -> ẩn khỏi khay */
        "ignore-list": ["nm-applet", "Fcitx"]
    }
}
]
